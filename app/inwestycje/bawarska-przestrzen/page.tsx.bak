        </div>
      </section>

      {/* Dom który daje Ci wolność Section */}
      <section className="py-16 lg:py-24 bg-background">
        <div className="container mx-auto px-4 lg:px-8">
          <div className="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
            <div className="relative aspect-[4/3] rounded-xl overflow-hidden order-2 lg:order-1">
              <Image
                src="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/Bawarska%20Przestrzen%CC%81%2011%20-PomOgqj4o6sYRVvBHxkqyen2VsxNaV.png"
                alt="Bawarska Przestrzeń - wizualizacja 3D wnętrza"
                fill
                className="object-cover"
              />
            </div>
            <div className="order-1 lg:order-2">
              <span
                className="inline-block px-4 py-1.5 rounded-full text-xs font-medium tracking-wide uppercase mb-4"
                style={{ backgroundColor: "rgba(110,46,42,0.1)", color: "#6E2E2A" }}
              >
                Dom
              </span>
              <h2 className="font-serif text-3xl lg:text-4xl font-semibold mb-6" style={{ color: "#3E1718" }}>
                Dom, który daje Ci wolność
              </h2>
              <p className="text-muted-foreground leading-relaxed">
                Wnętrza domów w Bawarskiej Przestrzeni to funkcjonalne układy o powierzchni od 112 m² do 114 m², które możesz zaaranżować tak, jak chcesz. Wysokie pomieszczenia dodają aranżacji lekkości, a dodatkowe pokoje – takie jak gabinet czy garderoba – sprawiają, że znajdziesz miejsce na wszystko, co ważne. Masz też możliwość przesunięcia ścian działowych już na etapie budowy, aby stworzyć układ idealnie dopasowany do Twojego stylu życia. To dom, który zmienia się razem z Tobą i Twoją rodziną.
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* High Standard Section */}
      <section className="py-20 lg:py-32 bg-background">
        <div className="container mx-auto px-4 lg:px-8">
          <div className="text-center mb-16">
            <span
              className="inline-block px-4 py-1.5 rounded-full text-xs font-medium tracking-wide uppercase mb-4"
              style={{ backgroundColor: "rgba(110,46,42,0.1)", color: "#6E2E2A" }}
            >
              Standard
            </span>
            <h2 className="font-serif text-3xl lg:text-5xl font-semibold mb-6" style={{ color: "#3E1718" }}>
              Wysoki standard wykończenia
            </h2>
            <p className="text-muted-foreground max-w-2xl mx-auto text-lg leading-relaxed">
              Każdy dom na Osiedlu Szlacheckim został zaprojektowany z myślą o komforcie i oszczędności energii
            </p>
          </div>

          <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {[
              {
                text: "Belgijska klinkierowa ręcznie formowana cegła na elewacji",
                icon: (
                  <svg className="w-7 h-7" style={{ color: "#6E2E2A" }} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.5}>
                    <path strokeLinecap="round" strokeLinejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z" />
                  </svg>
                ),
              },
              {
                text: "Ogrzewanie podłogowe na parterze i poddaszu",
                icon: (
                  <svg className="w-7 h-7" style={{ color: "#6E2E2A" }} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.5}>
                    <path strokeLinecap="round" strokeLinejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z" />
                  </svg>
                ),
              },
              {
                text: "Energooszczędne duże 3-szybowe okna",
                icon: (
                  <svg className="w-7 h-7" style={{ color: "#6E2E2A" }} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.5}>
                    <path strokeLinecap="round" strokeLinejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
                  </svg>
                ),
              },
              {
                text: "Ogrodzony teren inwestycji",
                icon: (
                  <svg className="w-7 h-7" style={{ color: "#6E2E2A" }} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.5}>
                    <path strokeLinecap="round" strokeLinejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                  </svg>
                ),
              },
              {
                text: "Możliwość instalacji ładowarek samochodowych",
                icon: <Zap className="w-7 h-7" style={{ color: "#6E2E2A" }} />,
              },
              {
                text: "Nowoczesne pompy ciepła",
                icon: (
                  <svg className="w-7 h-7" style={{ color: "#6E2E2A" }} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.5}>
                    <path strokeLinecap="round" strokeLinejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                  </svg>
                ),
              },
            ].map((feature, i) => (
              <div key={i} className="group relative bg-white rounded-2xl p-8 shadow-sm border border-border/30 hover:shadow-lg hover:border-[#6E2E2A]/20 transition-all duration-300">
                <div className="flex items-start gap-4 mb-4">
                  <div className="w-14 h-14 rounded-xl flex items-center justify-center flex-shrink-0" style={{ backgroundColor: "rgba(110,46,42,0.08)" }}>
                    {feature.icon}
                  </div>
                  <div className="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style={{ backgroundColor: "#6E2E2A" }}>
                    <Check className="w-4 h-4 text-white" />
                  </div>
                </div>
                <p className="text-muted-foreground leading-relaxed">{feature.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Gallery Section */}
      <section className="py-16 lg:py-24" style={{ backgroundColor: "#FAF8F5" }}>
        <div className="container mx-auto px-4 lg:px-8">
          <div className="text-center mb-12">
            <h2 className="font-serif text-3xl lg:text-4xl font-semibold mb-4" style={{ color: "#3E1718" }}>
              Galeria
            </h2>
          </div>
          <div className="grid grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-4">
            {/* Featured large */}
            <div
              onClick={() => setSelectedImage(0)}
              className="relative col-span-2 row-span-2 aspect-[4/3] rounded-xl overflow-hidden cursor-pointer group"
            >
              <Image src={galleryImages[0].src} alt={galleryImages[0].alt} fill className="object-cover transition-transform duration-500 group-hover:scale-105" />
              <div className="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors" />
            </div>
            {galleryImages.slice(1).map((image, index) => (
              <div
                key={index + 1}
                onClick={() => setSelectedImage(index + 1)}
                className="relative aspect-[4/3] rounded-xl overflow-hidden cursor-pointer group"
              >
                <Image src={image.src} alt={image.alt} fill className="object-cover transition-transform duration-500 group-hover:scale-105" />
                <div className="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors" />
              </div>
            ))}
          </div>
        </div>
      </section>



      {/* Informacje dodatkowe Section */}
      <section className="py-16 lg:py-24 bg-[#faf9f7]">
        <div className="container mx-auto px-4 lg:px-8">
          {/* Section Header */}
          <div className="text-center mb-12">
            <span
              className="inline-block px-4 py-1.5 rounded-full text-xs font-medium tracking-wide uppercase mb-4"
              style={{ backgroundColor: 'rgba(110, 46, 42, 0.1)', color: '#6E2E2A' }}
            >
              Dokumenty i cennik
            </span>
            <h2 className="font-serif text-3xl lg:text-4xl font-semibold mb-4" style={{ color: '#3E1718' }}>
              Informacje dodatkowe
            </h2>
            <p className="text-muted-foreground max-w-2xl mx-auto">
              Pobierz prospekty informacyjne oraz zapoznaj się ze szczegółowym cennikiem dodatkowych udogodnień
            </p>
          </div>

          <div className="grid lg:grid-cols-2 gap-8 lg:gap-12">
            {/* Download Prospectuses Card */}
            <div className="bg-white rounded-2xl p-8 shadow-sm border border-border/50">
              <div className="flex items-center gap-3 mb-6">
                <div 
                  className="w-12 h-12 rounded-full flex items-center justify-center"
                  style={{ backgroundColor: 'rgba(110, 46, 42, 0.1)' }}
                >
                  <FileText className="w-5 h-5" style={{ color: '#6E2E2A' }} />
                </div>
                <div>
                  <h3 className="font-serif text-xl font-semibold" style={{ color: '#3E1718' }}>
                    Prospekt informacyjny
                  </h3>
                  <p className="text-sm text-muted-foreground">Dokument do pobrania w formacie PDF</p>
                </div>
              </div>

              <a
                href="/prospekt-informacyjny-bawarska-przestrzen.pdf"
                target="_blank"
                rel="noopener noreferrer"
                className="group flex items-center gap-3 px-4 py-3 rounded-xl border border-border/50 bg-[#faf9f7] hover:bg-white transition-all hover:shadow-md"
              >
                <div className="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 transition-colors bg-[#3E1718] group-hover:bg-[#6E2E2A]">
                  <Download className="w-4 h-4 text-white" />
                </div>
                <span className="text-sm font-medium text-foreground">
                  Pobierz prospekt informacyjny
                </span>
              </a>
            </div>

            {/* Pricing Info Card */}
            <div className="bg-white rounded-2xl p-8 shadow-sm border border-border/50">
              <div className="flex items-center gap-3 mb-6">
                <div 
                  className="w-12 h-12 rounded-full flex items-center justify-center"
                  style={{ backgroundColor: 'rgba(110, 46, 42, 0.1)' }}
                >
                  <Info className="w-5 h-5" style={{ color: '#6E2E2A' }} />
                </div>
                <div>
                  <h3 className="font-serif text-xl font-semibold" style={{ color: '#3E1718' }}>
                    Cennik dodatkowych udogodnień
                  </h3>
                  <p className="text-sm text-muted-foreground">Szczegółowe informacje o cenach</p>
                </div>
              </div>

              <div className="space-y-4">
                {/* Regular pricing table */}
                <div className="rounded-xl border border-border/50 overflow-hidden">
                  <div className="px-4 py-3 font-medium text-sm text-white" style={{ backgroundColor: '#3E1718' }}>
                    Brak kosztów dodatkowych
                  </div>
                  <div className="p-6 bg-[#faf9f7] text-center">
                    <p className="text-muted-foreground">
                      Miejsca postojowe uwzględnione w cenie lokalu
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Buying Process */}
      <BuyingProcess />

      {/* Contact */}
      <Contact />

      <SiteFooter />

      {/* Gallery Lightbox */}
      {selectedImage >= 0 && (
        <div
          className="fixed inset-0 z-50 flex items-center justify-center bg-white/50 backdrop-blur-sm"
          onClick={() => setSelectedImage(-1)}
        >
          <button
            onClick={() => setSelectedImage(-1)}
            className="absolute top-4 right-4 lg:top-8 lg:right-8 w-12 h-12 flex items-center justify-center rounded-full bg-[#3E1718]/10 hover:bg-[#3E1718]/20 transition-colors z-50 border border-[#6E2E2A]/20"
            aria-label="Zamknij"
          >
            <X className="w-6 h-6 text-[#3E1718]" />
          </button>
          <div className="absolute top-4 left-4 lg:top-8 lg:left-8 px-4 py-2 rounded-full bg-[#3E1718]/10 text-[#3E1718] text-sm font-medium border border-[#6E2E2A]/20">
            {selectedImage + 1} / {galleryImages.length}
          </div>
          <button
            onClick={(e) => { e.stopPropagation(); handlePrevImage(); }}
            className="absolute left-4 lg:left-8 top-1/2 -translate-y-1/2 w-14 h-14 lg:w-16 lg:h-16 flex items-center justify-center rounded-full bg-white/90 hover:bg-white shadow-lg hover:shadow-xl transition-all z-50 border border-[#6E2E2A]/20"
            aria-label="Poprzednie zdjęcie"
          >
            <ChevronLeft className="w-7 h-7 lg:w-8 lg:h-8 text-[#3E1718]" />
          </button>
          <button
            onClick={(e) => { e.stopPropagation(); handleNextImage(); }}
            className="absolute right-4 lg:right-8 top-1/2 -translate-y-1/2 w-14 h-14 lg:w-16 lg:h-16 flex items-center justify-center rounded-full bg-white/90 hover:bg-white shadow-lg hover:shadow-xl transition-all z-50 border border-[#6E2E2A]/20"
            aria-label="Następne zdjęcie"
          >
            <ChevronRight className="w-7 h-7 lg:w-8 lg:h-8 text-[#3E1718]" />
          </button>
          <div
            className="relative w-[95vw] h-[90vh] lg:w-[90vw] lg:h-[90vh] flex items-center justify-center"
            onClick={(e) => e.stopPropagation()}
          >
            <Image
              src={galleryImages[selectedImage].src}
              alt={galleryImages[selectedImage].alt}
              width={1600}
              height={1100}
              className="max-w-full max-h-full object-contain rounded-2xl shadow-2xl"
              priority
            />
          </div>
        </div>
      )}
    </div>
  )
}
